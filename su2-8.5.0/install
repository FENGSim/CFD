sudo apt update
sudo apt -y install cmake make gcc g++ p7zip-full python3 python3-pip python3-setuptools re2c python3-fs

cd externals/meson/
python3 setup.py install --prefix=$PWD/../../../install/meson
cd ../ninja/
mkdir build
cd build
cmake .. -DCMAKE_INSTALL_PREFIX=../../../../install/ninja
make -j4
make install
cd ../../../

export PYTHONPATH=$PWD/../install/meson/local/lib/python3.13/dist-packages/meson-1.8.2-py3.13.egg/:$PYTHONPATH
export NINJA=$PWD/../install/ninja/bin/ninja

